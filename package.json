{
  "name": "english-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "dev:producto": "node scripts/preparar-producto.mjs && vite --host --mode producto --port 5273 --strictPort",
    "build:producto": "node scripts/preparar-producto.mjs && tsc --noEmit && vite build --mode producto --outDir dist-producto",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:producto": "node scripts/comprobar-producto.mjs",
    "iconos": "python scripts/iconos.py"
  },
  "dependencies": {
    "@fontsource/zilla-slab": "^5.2.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
